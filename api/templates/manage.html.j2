<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Spotify card connection</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; background: #0d1117; color: #f0f6fc; }
      main { width: min(430px, calc(100vw - 48px)); padding: 32px; background: #161b22; border: 1px solid #30363d; border-radius: 16px; }
      h1 { margin: 0 0 12px; font-size: 24px; }
      p { color: #b1bac4; line-height: 1.5; }
      .status { padding: 12px 14px; border-radius: 10px; background: #0d1117; }
      label { display: block; margin-bottom: 8px; }
      input { box-sizing: border-box; width: 100%; padding: 12px; color: inherit; background: #0d1117; border: 1px solid #484f58; border-radius: 8px; }
      button { width: 100%; margin-top: 14px; padding: 12px; border: 0; border-radius: 999px; background: #1ed760; color: #08130c; font-weight: 700; cursor: pointer; }
      .success { color: #3fb950; }
      .error { color: #f85149; }
      small { display: block; margin-top: 14px; color: #8b949e; }
    </style>
  </head>
  <body>
    <main>
      <h1>Spotify card connection</h1>
      {% if authenticated %}
        {% if connected %}<p class="success">Spotify was reconnected successfully.</p>{% endif %}
        <div class="status">
          {% if status.connected %}
            Connected{% if status.expires_at %} until {{ status.expires_at[:10] }}{% endif %}.
          {% else %}
            <span class="error">Spotify is not connected.</span>
          {% endif %}
          {% if not status.storage_configured %}
            <br><span class="error">Durable token storage still needs configuration.</span>
          {% endif %}
        </div>
        <form method="get" action="{{ login_path }}">
          <button type="submit">Reconnect Spotify</button>
        </form>
        <small>Spotify requires approval again every six months. Reconnecting here updates the card automatically.</small>
      {% else %}
        {% if error %}<p class="error">That management secret was not accepted.</p>{% endif %}
        <p>Enter the private management secret to reconnect the Spotify account used by this card.</p>
        <form method="post">
          <label for="secret">Management secret</label>
          <input id="secret" name="secret" type="password" required autocomplete="current-password">
          <button type="submit">Unlock</button>
        </form>
      {% endif %}
    </main>
  </body>
</html>
